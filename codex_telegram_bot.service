[Unit]
Description=Codex Telegram Bot
After=codex-remote-control.service
Requires=codex-remote-control.service

[Service]
Type=simple
WorkingDirectory=%h/codex_telegram_bot
ExecStart=/opt/codex_telegram_bot/.venv/bin/python /opt/codex_telegram_bot/bot.py
EnvironmentFile=/opt/codex_telegram_bot/.env
RestartForceExitStatus=100
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
