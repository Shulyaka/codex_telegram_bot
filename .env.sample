# Required Telegram credentials and allowed chats/users.
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1002345678901,-1234567890

# Project directory defaults to the process working directory.
# CODEX_TELEGRAM_REPO_DIR=/absolute/path/to/project
# Codex home defaults to ~/.codex; the socket defaults to its app-server-control directory.
# CODEX_HOME=/absolute/path/to/.codex
# CODEX_TELEGRAM_APP_SERVER_SOCKET=/absolute/path/to/.codex/app-server-control/app-server-control.sock

# true: read-only + never approvals; false: workspace-write + on-request + auto_review.
CODEX_TELEGRAM_READ_ONLY=true

# Optional custom instructions; relative paths use the project directory.
# CODEX_TELEGRAM_INSTRUCTIONS_FILE=./instructions.md
# Session store defaults to sessions.json in the project directory.
# CODEX_TELEGRAM_SESSION_STORE=/absolute/path/to/sessions.json

# Codex turn timeout; 0 means no timeout. Other timing settings require positive seconds.
CODEX_TELEGRAM_CODEX_TIMEOUT_SECONDS=0
CODEX_TELEGRAM_ATTACHMENT_RETENTION_SECONDS=86400
CODEX_TELEGRAM_COMPACTION_IDLE_SECONDS=86400
CODEX_TELEGRAM_ARCHIVE_IDLE_SECONDS=604800
CODEX_TELEGRAM_MAINTENANCE_INTERVAL_SECONDS=3600
CODEX_TELEGRAM_MAINTENANCE_TIMEOUT_SECONDS=600

# Background Git updates.
CODEX_TELEGRAM_GIT_PULL_TIMEOUT_SECONDS=120
CODEX_TELEGRAM_GIT_PULL_INTERVAL_SECONDS=300

# Guest deadline warning; must be less than 300 seconds.
CODEX_TELEGRAM_GUEST_WARNING_SECONDS=290
# Optional staging chat for images, stickers, and files in guest replies.
# CODEX_TELEGRAM_MEDIA_UPLOAD_CHAT_ID=-1004321098765

# Optional sticker and send_file directories; relative paths use the project directory.
# The upload directory must already exist before enabling file uploads.
# CODEX_TELEGRAM_STICKER_DIR=./stickers
# CODEX_TELEGRAM_UPLOAD_DIR=./uploads

# Telegram polling and concurrency.
CODEX_TELEGRAM_POLL_TIMEOUT_SECONDS=30
CODEX_TELEGRAM_CHAT_ACTION_INTERVAL_SECONDS=5
CODEX_TELEGRAM_MAX_CONCURRENT_CHATS=16
CODEX_TELEGRAM_DELETE_WEBHOOK_ON_START=false
CODEX_TELEGRAM_DROP_PENDING_UPDATES=false

CODEX_TELEGRAM_LOG_LEVEL=INFO
